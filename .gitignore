# --- Secrets (NEVER commit) ---
.env
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Tooling / venv ---
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# NOTE: uv's package cache is global (~/.cache/uv or $UV_CACHE_DIR) — not a repo artifact.
# uv.lock IS committed (reproducible installs) — do not ignore it.

# NOTE: data/*.csv IS committed on purpose — the suite runs offline and the
# numbers in the README are checkable. scripts/fetch_dataset.py regenerates it.

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/

# --- OpenTofu / Terraform (phase 13) ---
# .terraform/ is a provider cache (hundreds of MB); state can hold live
# credentials. The lock file IS committed, for the same reason uv.lock is:
# reproducible provider versions.
infra/tofu/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
