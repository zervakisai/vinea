# Copy to `.env` and fill in ONE provider key. The .env file is gitignored.
# Pydantic AI reads the provider key from the environment by these conventional names.

# VINEA_MODEL — any Pydantic AI model string (provider:model). Default: anthropic:claude-sonnet-4-5
# VINEA_MODEL=openai:gpt-5
# VINEA_MODEL=anthropic:claude-sonnet-4-5
# VINEA_MODEL=google-gla:gemini-2.5-flash

# Provider keys (set the one matching VINEA_MODEL):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional overrides:
# VINEA_DATA_DIR=./data
# VINEA_RUN_DATE=2026-06-27   # YYYY-MM-DD; defaults to today

# --- phase 6 (persistence) --------------------------------------------------------
# The app database. The compose stack publishes 55433 on the host (not 5432,
# which a system Postgres may hold; not 55432, a sibling project's) -- see
# docker-compose.yml.
DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:55433/vinea
POSTGRES_USER=vinea
POSTGRES_PASSWORD=vinea
POSTGRES_DB=vinea
POSTGRES_HOST_PORT=55433
# Where the DB tests point. Leave unset to fall back to DATABASE_URL; the DB
# tests SKIP (not fail) when neither is set, so the suite stays green on a
# machine with no Postgres at all.
# VINEA_TEST_DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:55433/vinea

# --- phase 9 (observability): self-hosted Langfuse -------------------------------
# Behind a compose profile:  docker compose --profile langfuse up -d
# then open http://localhost:3000 (login dev@vinea.local / vinea-local-pw).
# The keys below match the compose's headless-provisioned defaults, so setting
# these three exports traces to Langfuse immediately. Unset -> tracing is a
# no-op (advisories.trace_id stays NULL), which is the correct degrade.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-vinea
# LANGFUSE_SECRET_KEY=sk-lf-local-vinea
