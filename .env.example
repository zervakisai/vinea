# Copy to `.env` and fill in ONE provider key. The .env file is gitignored.
# Pydantic AI reads the provider key from the environment by these conventional names.

# VINEA_MODEL — any Pydantic AI model string (provider:model). Default: anthropic:claude-sonnet-4-5
# VINEA_MODEL=openai:gpt-5
# VINEA_MODEL=anthropic:claude-sonnet-4-5
# VINEA_MODEL=google-gla:gemini-2.5-flash

# Provider keys (set the one matching VINEA_MODEL):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional overrides:
# VINEA_DATA_DIR=./data
# VINEA_RUN_DATE=2026-06-27   # YYYY-MM-DD; defaults to today

# --- the application database -----------------------------------------------------
# The app database. The compose stack publishes 55433 on the host (not 5432,
# which a system Postgres may hold; not 55432, a sibling project's) -- see
# docker-compose.yml.
DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:55433/vinea
POSTGRES_USER=vinea
POSTGRES_PASSWORD=vinea
POSTGRES_DB=vinea
POSTGRES_HOST_PORT=55433
# Where the DB tests point. Leave unset to fall back to DATABASE_URL; the DB
# tests SKIP (not fail) when neither is set, so the suite stays green on a
# machine with no Postgres at all.
# VINEA_TEST_DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:55433/vinea

# --- tracing: self-hosted Langfuse (ADR-004) -------------------------------------
# Behind a compose profile:  docker compose --profile langfuse up -d
# then open http://localhost:3000 (login dev@vinea.local / vinea-local-pw).
#
# These three keys are REAL, not placeholders: the compose stack provisions the
# org, project and this exact keypair headlessly on first boot, so uncommenting
# them exports traces immediately with no signup step. Verified by
# `uv run pytest tests/test_langfuse_live.py`.
#
# All three or nothing: two of the three builds no exporter at all, which is the
# correct degrade. Unset -> advisories.trace_id stays NULL.
#
# Mint real keys through the UI for anything that is not a laptop -- this pair is
# in a tracked file.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-vinea
# LANGFUSE_SECRET_KEY=sk-lf-local-vinea

# --- prompts: the name@label registry reuses the LANGFUSE_* keys above ----------
# to fetch instruction framings; unset -> the bundled default floor (a no-op).
# VINEA_PROMPT_LABEL=production   # which label the agents fetch; 'staging' to preview
# VINEA_PROMPT_TTL=60             # SWR cache freshness window, seconds

# --- API keys, and the URL the UI talks to ----------------------------------------
# There is no VINEA_API_KEYS any more (ADR-012). API keys are rows in `api_keys`,
# stored as a SHA-256 and revocable with one UPDATE -- rather than plaintext in an
# environment variable that took a Secret edit and a rolling restart to change.
#
# Mint one after `alembic upgrade head`:
#
#   python -m vinea.keys issue --tenant acme --label "local dev"
#   python -m vinea.keys issue --ops --label "local dev ops"
#   python -m vinea.keys list
#   python -m vinea.keys revoke vinea_t_AbCdEfGh...
#
# Upgrading a deployment that already has keys in circulation? Import them first --
# it stores their hashes, so the keys people hold keep working and you can then
# delete the variables:
#
#   python -m vinea.keys import-env
#
# The two below are the *client* side, and they stay: the Streamlit UI reaches the
# system only through HTTP (ADR-005), so it holds credentials the way any client
# does. Paste in what `keys issue` printed.
VINEA_API_URL=http://localhost:8099
# VINEA_UI_TENANT_KEY=vinea_t_...   # the grower views
# VINEA_OPS_KEY=vinea_o_...         # the operator views, and `curl /ops/*`

# --- optional LLM gateway: LiteLLM in front of every model call (ADR-007) --------
# Behind a compose profile:  docker compose --profile gateway up -d
# UNSET is the default and it means "no gateway": resolve_model() returns the plain
# VINEA_MODEL string, nothing extra is in the path, and the four cost columns on
# `advisories` stay NULL -- which is honest, because nothing knew what anything cost.
# VINEA_GATEWAY_URL=http://localhost:4000
# The LiteLLM *virtual* key, not a provider key. That distinction is the security
# story: this key can spend at most its budget, and the provider key never leaves
# the gateway container.
# VINEA_GATEWAY_KEY=sk-vinea-tenant-acme
# The alias the app asks for; which model serves it lives in the gateway's config.
# VINEA_GATEWAY_MODEL=vinea-nightly
# VINEA_GATEWAY_TIMEOUT=90
#
# Gateway-side (read by the litellm container, not by the app):
# LITELLM_MASTER_KEY=sk-vinea-local-master   # mints and manages virtual keys
# LITELLM_HOST_PORT=4000

# --- retrieval: the FAO-56 corpus (ADR-011) --------------------------------------
# There is no on/off switch. Retrieval is on when the corpus is in the database
# and off when it is not -- a second flag would let the two disagree.
#   uv run python scripts/fetch_corpus.py   # regenerate data/corpus/ from FAO
#   python -m vinea.rag ingest              # embed it into corpus_chunks
#   python -m vinea.rag search "Kc grapes"  # see what an agent would be shown
#
# Retrieval is Postgres full-text search -- no embedding model, no vectors, no
# VINEA_EMBEDDING_MODEL (ADR-011). docker-compose still uses pgvector/pgvector:pg16
# because the migration creates the extension and `corpus_chunks.embedding` is
# kept as a reserved column; the stock postgres:16 image cannot run
# `CREATE EXTENSION vector` and the migration fails on it, deliberately.

# --- SLOs (ADR-010) ---------------------------------------------------------------
# The availability objective is "an advisory by 06:00 in the GROWER'S morning", so
# each tenant's zone lives on its grower_config row (IANA name, e.g. Europe/Athens).
# A tenant with no zone is judged against UTC -- stricter than their own morning for
# anyone east of Greenwich, so the gap shows up as a breach rather than being hidden.
#
#   curl -s localhost:8099/ops/slo -H "X-Ops-Key: $VINEA_OPS_KEY" | jq
#
# There is no /metrics endpoint. Nothing in this deployment scrapes, and a format
# that assumes a collector which does not exist is a format nobody reads (ADR-010).
#
# Where a breach is announced. UNSET is the default and a supported state: the
# breach is still recorded in `slo_breaches` and `slo check` still exits 1 -- it
# just tells nobody, which is what every run before this variable existed did.
#
# Any service that accepts a JSON POST works; the body carries `text` (Slack,
# Teams), `content` (Discord) and a structured `breaches` array, so this is a
# choice of URL rather than of vendor. For ntfy, use the topic URL directly.
#
# TREAT THIS AS A CREDENTIAL. A Slack or Discord webhook URL is a bearer token
# wearing a URL's clothes -- anyone holding it can post as you. It belongs in .env
# and in the Kubernetes Secret, never in values.yaml, and the code never logs it.
#
#   VINEA_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
#   VINEA_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/000/xxxx
#   VINEA_ALERT_WEBHOOK_URL=https://ntfy.sh/vinea-slo-<something-unguessable>
#
# Try it without waiting for 06:05:
#   python -m vinea.slo check          # posts only if something is actually breached
#   python -m vinea.slo check --no-notify   # ...or measure without saying anything
