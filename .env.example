# Copy to `.env` and fill in ONE provider key. The .env file is gitignored.
# Pydantic AI reads the provider key from the environment by these conventional names.

# VINEA_MODEL — any Pydantic AI model string (provider:model). Default: anthropic:claude-sonnet-4-5
# VINEA_MODEL=openai:gpt-5
# VINEA_MODEL=anthropic:claude-sonnet-4-5
# VINEA_MODEL=google-gla:gemini-2.5-flash

# Provider keys (set the one matching VINEA_MODEL):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional overrides:
# VINEA_DATA_DIR=./data
# VINEA_RUN_DATE=2026-06-27   # YYYY-MM-DD; defaults to today

# --- phase 6 (persistence) --------------------------------------------------------
# The app database. The compose stack publishes 55433 on the host (not 5432,
# which a system Postgres may hold; not 55432, a sibling project's) -- see
# docker-compose.yml.
DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:55433/vinea
POSTGRES_USER=vinea
POSTGRES_PASSWORD=vinea
POSTGRES_DB=vinea
POSTGRES_HOST_PORT=55433
# Where the DB tests point. Leave unset to fall back to DATABASE_URL; the DB
# tests SKIP (not fail) when neither is set, so the suite stays green on a
# machine with no Postgres at all.
# VINEA_TEST_DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:55433/vinea

# --- phase 9 (observability): self-hosted Langfuse -------------------------------
# Behind a compose profile:  docker compose --profile langfuse up -d
# then open http://localhost:3000 (login dev@vinea.local / vinea-local-pw).
# The keys below match the compose's headless-provisioned defaults, so setting
# these three exports traces to Langfuse immediately. Unset -> tracing is a
# no-op (advisories.trace_id stays NULL), which is the correct degrade.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-vinea
# LANGFUSE_SECRET_KEY=sk-lf-local-vinea

# --- phase 12 (prompts): the name@label registry reuses the LANGFUSE_* keys above --
# to fetch instruction framings; unset -> the bundled default floor (a no-op).
# VINEA_PROMPT_LABEL=production   # which label the agents fetch; 'staging' to preview
# VINEA_PROMPT_TTL=60             # SWR cache freshness window, seconds

# --- phase 10 (API) + phase 11 (UI): keys and the URL the UI talks to -----------------
# Per-tenant API keys as "key:tenant" pairs; a key opens only its own tenant.
VINEA_API_KEYS=key-acme:acme,key-olivares:olivares
# A separate key for the cross-tenant operator endpoints (/ops/*).
VINEA_OPS_KEY=ops-secret
# The Streamlit UI reaches the system ONLY through this URL (ADR-005), with the
# tenant key for grower views and the ops key (above) for operator views.
VINEA_API_URL=http://localhost:8099
VINEA_UI_TENANT_KEY=key-acme

# --- phase 14 (gateway): LiteLLM in front of every model call --------------------
# Behind a compose profile:  docker compose --profile gateway up -d
# UNSET is the default and it means "no gateway": resolve_model() returns the plain
# VINEA_MODEL string, nothing extra is in the path, and the four cost columns on
# `advisories` stay NULL -- which is honest, because nothing knew what anything cost.
# VINEA_GATEWAY_URL=http://localhost:4000
# The LiteLLM *virtual* key, not a provider key. That distinction is the security
# story: this key can spend at most its budget, and the provider key never leaves
# the gateway container.
# VINEA_GATEWAY_KEY=sk-vinea-tenant-acme
# The alias the app asks for; which model serves it lives in the gateway's config.
# VINEA_GATEWAY_MODEL=vinea-nightly
# VINEA_GATEWAY_TIMEOUT=90
#
# Gateway-side (read by the litellm container, not by the app):
# LITELLM_MASTER_KEY=sk-vinea-local-master   # mints and manages virtual keys
# LITELLM_HOST_PORT=4000
